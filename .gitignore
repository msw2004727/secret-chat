# Only reviewed project files are versioned; local exports and passwords stay local.
/*
!/.gitignore
!/.gitattributes
!/.firebaserc
!/firebase.json
!/database.rules.json
!/storage.rules
!/app.js
!/assets.js
!/config.js
!/index.html
!/pending.html
!/style.css
!/sw.js
!/manifest.json
!/*.png
!/README.md
!/AGENTS.md
!/package.json
!/package-lock.json
!/.github/
!/scripts/
!/docs/
!/domain-redirect/
!/functions/
/functions/*
!/functions/index.js
!/functions/package.json
!/functions/package-lock.json
!/functions/test-*.mjs
!/functions/.env.example
**/node_modules/
**/.env
**/.env.*
!**/.env.example
**/gha-creds-*.json
**/*debug*.log
**/*.pem
**/*.key
**/.DS_Store
/.cloud-local/
/.hosting-build/
