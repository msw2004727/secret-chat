rules_version = '2';

/* ============================================================
 *  Cloud Storage 安全規則 —— 只放「已經加密過」的照片原圖
 *
 *  ⚠️ 這裡跟 Realtime Database 的規則一樣，擋得住的只有兩件事：
 *       ① 沒登入的人（連匿名都沒有）
 *       ② 亂猜路徑的人
 *     真正保護內容的是「檔案上傳前就在瀏覽器裡加密過了」——
 *     這個桶子裡沒有任何一個位元組是看得懂的。
 *
 *  ⚠️ 路徑刻意是 media/<房間位址>/<亂數>：
 *     房間位址是密碼推導出來的 32 字，猜不到；亂數讓同一間房的檔案也列不出來。
 *
 *  ⚠️ 7 天自動刪除「不是」寫在這裡。
 *     那是 Google Cloud Storage 的生命週期規則（主控台設定：
 *     年齡 7 天 + 前置字元 media/ → 刪除物件）。
 *     規則檔管的是「誰能存取」，生命週期管的是「什麼時候消失」，兩件事。
 * ============================================================ */

service firebase.storage {
  match /b/{bucket}/o {

    match /media/{roomId}/{fileId} {

      // 讀：登入過、而且路徑長度對得上（房間位址一定是 32 字）
      allow read: if request.auth != null
                  && roomId.matches('^[0-9a-f]{32}$')
                  && fileId.matches('^[0-9a-f]{16,64}$')
                  && (request.auth.token.firebase.sign_in_provider == 'anonymous'
                      || request.auth.token.firebase.sign_in_provider == 'custom');

      // 寫：登入身分、路徑、大小、以及「一定要是不透明的二進位」。
      // 加密後的東西沒有 MIME 可言，所以只收 application/octet-stream。
      //
      // ⚠️ Storage 規則讀不到 Realtime Database，沒辦法在這裡查 acl/ok。
      //    房間成員能做的對應檢查是：
      //      ‧ 房號必須是密碼推導的 32 字十六進位（跟資料庫房間位址同一種）
      //      ‧ 檔名必須是客戶端 mediaId() 那種十六進位亂數
      //      ‧ 上傳者把 auth.uid 寫進 metadata.owner，而且不能覆蓋別人的檔
      //      ‧ 只接受這個 App 實際用的登入方式（匿名，或 LINE 的 custom token）
      //    審查關閉時，匿名登入就是進房的那個人；審查開啟時，進房的是 LINE custom token。
      //
      // ⚠️ 上限跟客戶端實際送出的檔一樣：照片先壓到 photoMaxUploadMB（6 MB），
      //    影片不轉檔、明文上限 videoMaxUploadMB（50 MB）。AES-GCM 只多 16 bytes，
      //    這裡留 64 KB 給標頭。規則分不出照片或影片，所以照片理論上也能塞到這個上限。
      allow write: if request.auth != null
                   && roomId.matches('^[0-9a-f]{32}$')
                   && fileId.matches('^[0-9a-f]{16,64}$')
                   && (request.auth.token.firebase.sign_in_provider == 'anonymous'
                       || request.auth.token.firebase.sign_in_provider == 'custom')
                   && (request.resource == null
                       || (request.resource.size < 50 * 1024 * 1024 + 64 * 1024
                           && request.resource.contentType == 'application/octet-stream'
                           && request.resource.metadata.owner == request.auth.uid
                           && (resource == null || resource.metadata.owner == request.auth.uid)));
    }

    // 其餘路徑一律封死。沒有這一條的話，別人可以拿你的桶子當圖床。
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
